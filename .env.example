# Application
APP_NAME="Dark Web Monitoring Platform"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
SECRET_KEY="your-secret-key-change-this-in-production"

# API
API_V1_PREFIX="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database - MongoDB
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="darkweb_monitor"

# Database - PostgreSQL
POSTGRES_SERVER="localhost"
POSTGRES_USER="darkweb_user"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_DB="darkweb_monitor"
POSTGRES_PORT=5432

# Redis
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Tor Configuration
TOR_PROXY_HOST="127.0.0.1"
TOR_PROXY_PORT=9050
TOR_CONTROL_PORT=9051
TOR_PASSWORD=""
USE_TOR=true

# Scraping Configuration
SCRAPING_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
SCRAPING_DELAY_MIN=2
SCRAPING_DELAY_MAX=5
SCRAPING_TIMEOUT=30
MAX_CONCURRENT_REQUESTS=5

# NLP Configuration
NLP_MODEL="en_core_web_sm"
SENTIMENT_MODEL="distilbert-base-uncased-finetuned-sst-2-english"
USE_GPU=false

# Alert Configuration
ALERT_EMAIL_ENABLED=true
ALERT_SLACK_ENABLED=false
ALERT_WEBHOOK_ENABLED=false

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-email-password"
SMTP_FROM="noreply@darkwebmonitor.com"
ALERT_RECIPIENTS=["security@yourcompany.com"]

# Slack Configuration
SLACK_WEBHOOK_URL=""
SLACK_CHANNEL="#security-alerts"

# Webhook Configuration
WEBHOOK_URL=""
WEBHOOK_SECRET=""

# Monitoring Keywords (comma-separated)
MONITOR_KEYWORDS="your-company,your-domain.com,your-brand"
MONITOR_DOMAINS="yourcompany.com,yourdomain.com"
MONITOR_EMAILS="@yourcompany.com"

# Security
JWT_SECRET_KEY="your-jwt-secret-key-change-this"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL="INFO"
LOG_FILE="logs/app.log"

# Data Retention (in days)
DATA_RETENTION_DAYS=365
CLEANUP_ENABLED=true

# Features
ENABLE_AUTO_SCANNING=true
ENABLE_THREAT_INTELLIGENCE=true
ENABLE_IOC_EXTRACTION=true
ENABLE_ACTOR_PROFILING=true

# Scan Schedule (cron format)
SCAN_SCHEDULE_FORUMS="0 */6 * * *"  # Every 6 hours
SCAN_SCHEDULE_PASTES="0 */1 * * *"  # Every hour
SCAN_SCHEDULE_MARKETPLACES="0 */12 * * *"  # Every 12 hours
SCAN_SCHEDULE_TELEGRAM="0 */2 * * *"  # Every 2 hours
